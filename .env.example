# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Database and cache ---
DATABASE_URL=postgresql+psycopg://vaani:vaani@localhost:5432/vaani
REDIS_URL=redis://localhost:6379/0

# --- LLMs (free tiers) ---
GROQ_API_KEY=
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_SMART=llama-3.3-70b-versatile
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Local fallbacks (16 GB laptops only) ---
ENABLE_LOCAL_FALLBACKS=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
WHISPER_LOCAL_MODEL=small

# --- Speech ---
GROQ_WHISPER_MODEL=whisper-large-v3
TTS_VOICE_TE=te-IN-ShrutiNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_VOICE_EN=en-IN-NeerjaNeural

# --- Observability (Langfuse Cloud free Hobby tier) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Telegram (week 6) ---
TELEGRAM_BOT_TOKEN=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
